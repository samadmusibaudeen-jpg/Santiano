{
  "name": "santiano-shop",
  "version": "1.0.0",
  "description": "Santiano: online shop with a Supabase catalogue and admin page (zero dependencies, Node 22.13+)",
  "main": "server/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --watch --disable-warning=ExperimentalWarning server/index.js",
    "reset-admin": "node --disable-warning=ExperimentalWarning scripts/reset-admin.js",
    "test": "node --disable-warning=ExperimentalWarning scripts/e2e.js && node --disable-warning=ExperimentalWarning scripts/accounting-test.js"
  },
  "license": "UNLICENSED"
}
