# Copy to .env and fill in. Nothing else is needed to run: no npm install.

# ---- Supabase (your product catalogue and photos) ----
# Dashboard -> Settings -> API. Use the project URL and the *service_role* key (keep it secret, server only).
SUPABASE_URL=https://pnnsvcimfvukugimigcj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InBubnN2Y2ltZnZ1a3VnaW1pZ2NqIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc5MzM1Nzc0MywiZXhwIjoyMTA4OTMzNzQzfQ.y0XYthjtbx9YIK9V6ec_KdK2b-PE-FLlVfLsEEzKz0E
# Storage bucket for product photos (created by sql/supabase.sql)
SUPABASE_BUCKET=product-images

# ---- Admin login (created on first run) ----
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-long-password

# ---- Shop ----
SHOP_NAME=Santiano
PUBLIC_URL=http://localhost:3000
PORT=3000
# Long random string used to sign login tokens
APP_SECRET=

# ---- Payments (Paystack) ----
# Leave empty to try the shop in DEMO mode (orders are marked paid without charging anyone).
PAYSTACK_SECRET_KEY=
# Optional: DEMO_PAYMENTS=false forces real payments only.
DEMO_PAYMENTS=

# ---- Email (optional; otherwise order emails are only written to the server log) ----
RESEND_API_KEY=
MAIL_FROM=Santiano <orders@yourdomain.com>
